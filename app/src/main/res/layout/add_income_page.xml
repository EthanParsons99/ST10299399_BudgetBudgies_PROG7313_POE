<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/nav_toolbar"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:background="#800080"
        android:title="Add Income or Expenses"
        android:titleTextColor="#FFFFFF"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/addIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">


            <RadioGroup
                android:id="@+id/radioGroupType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/smallerbox_green"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="Income"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:id="@+id/radioExpenditure"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/smallerbox_red"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="Expenditure"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Date -->
            <EditText
                android:id="@+id/currentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/white_textbox"
                android:hint="dd/mm/yyyy"
                android:padding="12dp"
                android:textColor="#000000"
                android:textColorHint="#888888" />

            <!-- Amount + Currency -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/white_textbox"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <EditText
                    android:id="@+id/amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Amount"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888" />

                <Spinner
                    android:id="@+id/spinnerCurrency"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- Currency Text -->
            <TextView
                android:id="@+id/tvCurrencySelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Selected: ZAR"
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <EditText
        android:id="@+id/editTextText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name" />
</LinearLayout>
