<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="16dp">

        <!-- Type Selection -->
        <RadioGroup
            android:id="@+id/radioGroupType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/radioIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Income"
                android:background="@drawable/smallerbox_green"
                android:textColor="#FFFFFF"
                android:padding="12dp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <RadioButton
                android:id="@+id/radioExpenditure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expenses"
                android:background="@drawable/smallerbox_red"
                android:textColor="#FFFFFF"
                android:padding="12dp" />
        </RadioGroup>

        <!-- Date Input -->
        <EditText
            android:id="@+id/currentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/white_textbox"
            android:hint="dd/mm/yyyy"
            android:padding="12dp"
            android:textColor="#000"
            android:textStyle="bold" />

        <!-- Account Spinner -->
        <Spinner
            android:id="@+id/spinnerAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/white_textbox"
            android:spinnerMode="dropdown" />

        <!-- Amount and Currency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/white_textbox"
                android:hint="Amount"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spinnerCurrency"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:background="@drawable/white_textbox" />
        </LinearLayout>

        <!-- Category Spinner -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/white_textbox" />

        <!-- Description -->
        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/white_textbox"
            android:hint="Description"
            android:padding="12dp" />

        <!-- Attach Receipt -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/white_textbox"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Attach Receipt"
                android:textColor="#000" />

            <ImageView
                android:id="@+id/receiptIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_camera" />
        </LinearLayout>

        <!-- Displayed d -->
        <TextView
            android:id="@+id/tvCurrencySelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Selected Currency"
            android:textColor="#000" />

        <!-- Buttons for save and delete -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SAVE"
            android:textColor="#000"
            android:backgroundTint="#ADD8E6" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DELETE"
            android:textColor="#000"
            android:backgroundTint="#FFFFFF" />
    </LinearLayout>
</ScrollView>
